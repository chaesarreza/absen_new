    <script>
      document.addEventListener('DOMContentLoaded', () => {
          // Temukan semua container 3D
          const tiltContainers = document.querySelectorAll('[data-tilt-container]');
          
          tiltContainers.forEach(container => {
              // Temukan target yang akan miring di dalam container
              const card = container.querySelector('[data-tilt-target]');
              
              if (card) {
                  container.addEventListener('mousemove', (e) => {
                      let rect = container.getBoundingClientRect();
                      // Hitung posisi mouse relatif ke tengah container
                      let x = (e.clientX - rect.left - rect.width / 2) / (rect.width / 2);
                      let y = (e.clientY - rect.top - rect.height / 2) / (rect.height / 2);
                      
                      const maxRotate = 7; // Max 7 derajat
                      
                      let rotateY = x * maxRotate;
                      let rotateX = -y * maxRotate;
                      
                      // Terapkan style transform
                      card.style.transform = `perspective(1500px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.03)`;
                      card.style.transition = 'transform 0.05s linear';
                  });
          
                  container.addEventListener('mouseleave', () => {
                      // Reset transformasi
                      card.style.transform = 'perspective(1500px) rotateX(0deg) rotateY(0deg) scale(1)';
                      card.style.transition = 'transform 0.4s ease-out, box-shadow 0.4s ease-out';
                  });
              }
          });
      });
    </script>
